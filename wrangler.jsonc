// Cloudflare Workers static assets (ADR-004). The whole site is the assembled dist/.
// `pnpm preview` runs `wrangler dev` against this file, so local preview matches production.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "games-dnlmn",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    // Unknown paths get the nearest 404.html (the launcher's custom 404).
    "not_found_handling": "404-page",
    // /snake -> /snake/ ; /snake/index.html is served at /snake/.
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "games.dnlmn.dev",
      "custom_domain": true
    }
  ]
}
