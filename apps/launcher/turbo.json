{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!public/thumbs/**",
        "!public/og/**",
        "$TURBO_ROOT$/games/*/game.json",
        "$TURBO_ROOT$/games/*/thumbnail.png",
        "$TURBO_ROOT$/games/*/preview.webp",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/scripts/lib/**"
      ],
      "outputs": ["dist/**", "public/thumbs/**", "public/og/**"]
    }
  }
}
