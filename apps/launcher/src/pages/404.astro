---
import Base from '../layouts/Base.astro';
import '../styles/not-found.css';
---

<Base title="Nothing here" description="Nothing at this address. Defend a little corner of space instead." path="/404.html" noindex minimal>
  <section class="lost wrap" aria-labelledby="lost-title">
    <section class="shooter" data-shooter aria-label="Void Patrol space shooter">
      <div class="shooter-board" data-shooter-board>
        <div class="shooter-hud" data-shooter-hud hidden>
          <div><span class="shooter-label">Score</span><output class="shooter-score" data-shooter-score aria-live="off">0</output></div>
          <div class="shooter-shields"><span class="shooter-label">Shields</span><output data-shooter-shields aria-live="off" aria-label="3 shields">◆ ◆ ◆</output></div>
        </div>
        <svg class="shooter-poster" viewBox="0 0 360 400" aria-hidden="true">
          <g fill="var(--muted)" opacity=".5"><circle cx="40" cy="60" r="1" /><circle cx="280" cy="180" r="1.5" /><circle cx="190" cy="250" r="1" /><circle cx="70" cy="300" r="1.5" /><circle cx="320" cy="320" r="1" /></g>
          <g stroke="var(--secondary)" fill="none" stroke-width="2"><path d="M55 90 65 76 80 90 75 101 60 101Z" /><path d="M165 120 180 104 195 120 190 130 170 130Z" /><path d="M275 80 290 65 305 80 300 90 280 90Z" /></g>
          <path d="M180 329 198 360 185 354 180 361 175 354 162 360Z" fill="var(--accent)" />
          <path d="M180 288V250 M180 215V180" stroke="var(--accent)" stroke-width="3" />
        </svg>
        <canvas data-shooter-canvas width="360" height="400" tabindex="0" aria-label="Space shooter. Your ship follows your mouse or finger. Move in any direction with the arrow keys or WASD. Your ship fires automatically.">Space shooter preview. JavaScript is needed to play.</canvas>
        <div class="shooter-over" data-shooter-over hidden>
          <h2>Nice try.</h2>
          <p data-shooter-result></p>
          <button class="btn primary" type="button" data-shooter-retry>Fly again <span aria-hidden="true">↗</span></button>
        </div>
      </div>
      <p class="shooter-status sr-only" data-shooter-status role="status"></p>
    </section>
    <div class="lost-copy">
      <h1 id="lost-title">404</h1>
      <h2>Nothing here.</h2>
      <a class="lost-home" href="/">Back to the games <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<script>
  import { bootShooter } from '../scripts/not-found.ts';
  bootShooter();
</script>
