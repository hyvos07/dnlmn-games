---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page doesn't exist." path="/404.html">
  <article class="prose wrap">
    <p class="kicker">Error 404</p>
    <h1>Game over.</h1>
    <svg viewBox="0 0 320 64" width="320" height="64" aria-hidden="true" style="max-width:100%;color:var(--accent)">
      <path
        d="M14 44H124V22H190V44H262"
        fill="none"
        stroke="currentColor"
        stroke-width="16"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M261 36.5l5 5m0-5l-5 5M261 46.5l5 5m0-5l-5 5"
        stroke="var(--bg)"
        stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
    <p>This page ran into a wall. It doesn't exist, or it moved.</p>
    <p><a class="btn primary" href="/">Back to the games</a></p>
  </article>
</Base>
