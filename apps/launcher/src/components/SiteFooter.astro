---
import { getGames } from '../lib/games.ts';

const latest = (await getGames()).slice(0, 4);
const year = new Date().getFullYear();
---

<footer class="footer" id="footer" data-section="footer">
  <!-- A grid-snapped snake: static here, chases the cursor once motion loads. -->
  <svg
    class="trail"
    data-trail
    viewBox="0 0 440 176"
    preserveAspectRatio="xMaxYMax meet"
    aria-hidden="true">
    <path
      d="M418 154H330V132H286V110H242V88H198"
      fill="none"
      stroke="currentColor"
      stroke-width="14"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.9"></path>
    <circle cx="194" cy="85" r="2.6" fill="var(--bg)"></circle>
    <circle cx="194" cy="92" r="2.6" fill="var(--bg)"></circle>
  </svg>
  <div class="footer-grid wrap">
    <p class="footer-big">Keep<br /><span>playing.</span></p>
    <div>
      <h2>Latest</h2>
      <ul>
        {latest.map((game) => <li><a href={game.href} data-game-link>{game.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Site</h2>
      <ul>
        <li><a href="/#games">All games</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/sitemap.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
  <div class="fineprint wrap">
    <span>© {year} dnlmn · No cookies. No trackers. Just games.</span>
    <span>Built with Astro, OGL and anime.js</span>
  </div>
</footer>
