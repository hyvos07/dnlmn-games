---
import { label } from '../lib/games.ts';

interface Props {
  tags: Array<{ tag: string; count: number }>;
  total: number;
  active?: string | undefined;
}
const { tags, total, active } = Astro.props;
---

<nav class="filter" aria-label="Filter games" data-filter>
  <ul class="chips">
    <li>
      <a class="chip" href="/#games" data-tag="" aria-current={active ? undefined : 'true'}
        >All <span class="chip-n">{total}</span></a
      >
    </li>
    {
      tags.map(({ tag, count }) => (
        <li>
          <a
            class="chip"
            href={`/tag/${tag}/`}
            data-tag={tag}
            aria-current={active === tag ? 'true' : undefined}
          >
            {label(tag)} <span class="chip-n">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <button class="toggle" type="button" data-touch-toggle data-js-only aria-pressed="false">
    <span class="switch" aria-hidden="true"></span>
    Touch-friendly only
  </button>
</nav>
