---
import displayFont from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-800-normal.woff2?url';
import sansFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { getAccent } from '@games/config/theme';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Path for the canonical URL, e.g. "/about/". */
  path: string;
  ogImage?: string;
  /** Run the WebGL scene (index only). Other pages show the static poster. */
  scene?: boolean;
  /** Pre-applied tag filter (the /tag/<tag>/ pages). */
  tag?: string;
  /** Tags the head script may accept from ?tag= (so unknown values are ignored). */
  tags?: string[];
  /** Extra CSS generated by the page (filter rules). */
  css?: string;
  nav?: 'games' | 'about';
}

const {
  title,
  description = 'Small browser games by dnlmn. Free, instant, no install, no tracking.',
  path,
  ogImage = '/og/home.png',
  scene = false,
  tag,
  tags = [],
  css = '',
  nav,
} = Astro.props;

const site = Astro.site?.origin ?? 'https://games.dnlmn.dev';
const fullTitle = title ? `${title} · Games by dnlmn` : 'Games by dnlmn';
const a = getAccent();
const tokens = `:root{--accent:${a.accent};--on-accent:${a.onAccent};--accent-text-dark:${a.accentTextDark};--accent-text-light:${a.accentTextLight};--secondary:${a.secondary}}`;
const fonts = `@font-face{font-family:"Bricolage Grotesque";font-style:normal;font-weight:800;font-display:optional;src:url(${displayFont}) format("woff2")}@font-face{font-family:"Instrument Sans";font-style:normal;font-weight:400 700;font-display:optional;src:url(${sansFont}) format("woff2")}`;
// Runs before first paint: marks JS as available and applies ?tag= / ?touch=1 so a
// filtered page never renders unfiltered first (CLS 0).
const headScript = `(function(d){d.classList.add('js');try{var q=new URLSearchParams(location.search),t=q.get('tag');if(t&&${JSON.stringify(tags)}.indexOf(t)>-1)d.setAttribute('data-tag',t);if(q.get('touch')==='1')d.setAttribute('data-touch','')}catch(e){}})(document.documentElement)`;
---

<!doctype html>
<html lang="en" data-tag={tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0C0C10" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Games by dnlmn" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, site).href} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={tokens + fonts + css}></style>
    <script is:inline set:html={headScript}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="scene" id="scene" data-webgl={scene ? '' : undefined} aria-hidden="true"></div>
    <div class="page">
      <SiteHeader current={nav} />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      import '../scripts/boot.ts';
    </script>
  </body>
</html>
