{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/.astro", "!**/.turbo", "!packages/templates/**/game.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "localStorage": "Use game.storage from @games/sdk (RULES §3).",
              "sessionStorage": "Use game.storage from @games/sdk (RULES §3)."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/sdk/src/storage.ts"],
      "linter": { "rules": { "style": { "noRestrictedGlobals": "off" } } }
    }
  ]
}
